NODE_ENV=development
PORT=5000
APP_URL=http://localhost:3000
API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

MONGODB_URI=mongodb://localhost:27017/poultryhub

# Required. In production use 32+ random chars (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAYMENT_PROVIDER=
PAYMENT_API_KEY=
# Signs payment callbacks: header X-Payment-Signature = hex HMAC-SHA256 of the raw body.
# Callbacks are rejected while this is empty.
PAYMENT_SECRET=

# CamPay mobile money (MTN MoMo / Orange Money). Demo: https://demo.campay.net
CAMPAY_USE_DEMO=true
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_APP_ID=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# Optional permanent token, used when username/password are not set.
CAMPAY_TOKEN=
# Verifies webhook calls. Webhook URL to set in CamPay: <API_URL>/api/payments/campay/webhook
CAMPAY_WEBHOOK_KEY=
# true = fake successful payments without calling CamPay (ignored in production)
CAMPAY_SIMULATION=false
# Demo accounts only accept small amounts: charges are capped to this in demo mode.
CAMPAY_DEMO_MAX_AMOUNT=25

SOCKET_CORS_ORIGIN=http://localhost:3000

# PoultryBot AI: engines are tried in order OpenRouter -> NVIDIA NIM -> Gemini -> OpenAI,
# then a built-in local fallback. Only engines with a key are used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional, comma-separated models OpenRouter falls back to.
OPENROUTER_FALLBACK_MODELS=

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
GEMINI_API_KEY=
OPENAI_API_KEY=
